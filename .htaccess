# Polikon — Apache yapılandırması (cPanel uyumlu)

# index.php öncelikli açılış dosyası
DirectoryIndex index.php index.html

# Özel 404 sayfası
ErrorDocument 404 /404.php

# HTTPS zorunlu + sitemap.xml -> sitemap.php
<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTP -> HTTPS yönlendirme — SSL sertifikası hazır olunca aşağıdaki 5 satırın
    # başındaki '#' işaretlerini kaldırarak aktif edin.
    # RewriteCond %{HTTP_HOST} !^localhost [NC]
    # RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # www yerine köke (isteğe bağlı; www kullanacaksanız bu bloğu kaldırın)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# ---- Güvenlik başlıkları ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # HSTS — HTTPS zorunlu hale getirildiğinde (yukarıdaki yönlendirmeyle birlikte) aktif edin.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    # İçerik Güvenlik Politikası (Google Fonts + Google Maps gömme + satır içi stil/script'e izin verir)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; base-uri 'self'; form-action 'self' https://www.google.com; object-src 'none'"
    # Hassas dosyalar için no-cache
    <FilesMatch "\.(php)$">
        Header set X-Robots-Tag "noarchive"
    </FilesMatch>
</IfModule>

# Dizin listelemeyi kapat
Options -Indexes

# Hassas dosyalara doğrudan erişimi engelle
<FilesMatch "^(config\.php|secrets\.php|\.env|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Çekirdek/şablon klasörlerine doğrudan HTTP erişimini engelle
RedirectMatch 403 ^/(includes|partials|dev|_eski_html_yedek)(/.*)?$

# UTF-8
AddDefaultCharset UTF-8

# Basit önbellek (statik varlıklar)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
